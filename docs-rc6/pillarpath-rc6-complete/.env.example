# ============================================================================
# PillarPath RC6 — Environment Variables Template
# ============================================================================
# Copy this to .env.local and fill in your values
# For Docker: values can be set in docker-compose.yml or .env file

# ============================================================================
# DATABASE (Required)
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
#
# Local example:
DATABASE_URL=postgresql://pillarpath:pillarpath-dev-password-change-in-prod@localhost:5432/pillarpath
#
# Production example (AWS RDS):
# DATABASE_URL=postgresql://pillarpath:your-secure-password@my-rds.us-east-1.rds.amazonaws.com:5432/pillarpath
#
# Production example (Vercel Postgres):
# DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.postgres.vercel-storage.com/pillarpath

# ============================================================================
# AUTHENTICATION (Required)
# ============================================================================
# Generate with: openssl rand -base64 32
# MUST be at least 32 characters for production
JWT_SECRET=your-secret-key-here-minimum-32-characters-required

# Auth redirect URL (used for OAuth callbacks)
AUTH_URL=http://localhost:8080

# For production, set to your domain:
# AUTH_URL=https://pillarpath.example.com

# ============================================================================
# APPLICATION
# ============================================================================
# Environment: development | production | staging
NODE_ENV=development

# Port the app listens on
PORT=8080

# Enable debug logging
DEBUG=false

# ============================================================================
# STRIPE (Optional — required for marketplace checkout)
# ============================================================================
# Get from: https://dashboard.stripe.com/account/apikeys
#
# Live keys (start with sk_live_):
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Publishable key (start with pk_live_):
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Webhook signing secret (start with whsec_):
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ============================================================================
# DROPSHIP / PRINT-ON-DEMAND (Optional)
# ============================================================================
# Dropship API key for merchandise fulfillment
DROPSHIP_API_KEY=your-api-key-here

# Webhook token for dropship order updates
DROPSHIP_WEBHOOK_TOKEN=your-webhook-token-here

# ============================================================================
# REDIS (Optional — for session store & caching)
# ============================================================================
# Default: in-memory store (not recommended for production)
# Redis URL format: redis://[:password]@[host][:port][/db]
#
# Local:
# REDIS_URL=redis://localhost:6379
#
# Production (e.g., AWS ElastiCache):
# REDIS_URL=redis://:your-auth-token@my-elasticache.us-east-1.cache.amazonaws.com:6379

# ============================================================================
# EMAIL (Optional — for notifications)
# ============================================================================
# SendGrid API key
SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# Email sender address
SENDGRID_FROM_EMAIL=noreply@pillarpath.example.com

# ============================================================================
# OAUTH PROVIDERS (Optional)
# ============================================================================
# Google OAuth (for "Sign in with Google")
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx

# GitHub OAuth
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxx

# Apple OAuth
APPLE_CLIENT_ID=xxxxxxxxxxxx
APPLE_TEAM_ID=xxxxxxxxxxxx
APPLE_KEY_ID=xxxxxxxxxxxx
APPLE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ============================================================================
# SMS / PHONE VERIFICATION (Optional)
# ============================================================================
# Twilio API credentials (for phone verification)
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# MONITORING & OBSERVABILITY (Optional)
# ============================================================================
# Sentry error tracking
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=production

# DataDog APM
DATADOG_API_KEY=xxxxxxxxxxxx
DATADOG_APP_KEY=xxxxxxxxxxxx

# ============================================================================
# CORPORATE / ADMIN
# ============================================================================
# Enable admin panel (requires corporate membership role)
ADMIN_PANEL_ENABLED=true

# Email addresses with system admin access (comma-separated)
SYSTEM_ADMINS=admin@pillarpath.example.com,support@pillarpath.example.com

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Toggle features on/off
FEATURE_MARKETPLACE_ENABLED=true
FEATURE_DROPSHIP_ENABLED=false
FEATURE_MULTIPLAYER_ENABLED=false
FEATURE_LEARNING_TRACKING_ENABLED=true
FEATURE_CORPORATE_PORTAL_ENABLED=false

# ============================================================================
# KIDS / COPPA SETTINGS
# ============================================================================
# Minimum age for sign-up (default 4)
KIDS_MIN_AGE=4

# Maximum age for kids program (default 17)
KIDS_MAX_AGE=17

# Require parental consent (COPPA compliance)
REQUIRE_PARENTAL_CONSENT=true

# Data retention policy (days, -1 = forever)
KIDS_DATA_RETENTION_DAYS=2555  # ~7 years

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
# Seed database with demo data on startup
SEED_DATABASE=false

# Enable GraphQL playground (if GraphQL API is configured)
GRAPHQL_PLAYGROUND=false

# Disable HTTPS requirement locally
ALLOW_INSECURE_HTTP=true  # Set to false in production!

# ============================================================================
# NOTES
# ============================================================================
# - Never commit .env.local to git (add to .gitignore)
# - Always use HTTPS in production
# - Rotate JWT_SECRET periodically
# - Use AWS Secrets Manager or similar for sensitive values
# - Verify all webhook secrets and API keys before going live
# - Test OAuth redirect URIs before deploying

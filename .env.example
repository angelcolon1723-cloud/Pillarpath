# PillarPath environment variables
# Copy to your hosting provider's environment settings. Never commit real secrets.

# Database (Postgres). Required in production; local dev falls back to PGLite.
DATABASE_URL=postgresql://user:password@localhost:5432/pillarpath

# Auth (Better Auth)
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=https://your-production-url.example.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: price IDs for subscriptions
STRIPE_PRICE_CORE=price_...
STRIPE_PRICE_FAMILY=price_...
STRIPE_PRICE_STUDIO_PLUS=price_...

# Dropshipping / fulfillment (optional)
PRINTFUL_API_KEY=
PRINTIFY_API_TOKEN=
SPOCKET_API_KEY=

# Android / Capacitor packaging
# The web app URL the beta APK shell loads. Set this before `npx cap sync android`.
PILLARPATH_WEB_URL=https://your-production-url.example.com

# Client-side (VITE_ prefix only) — safe to expose in the browser bundle
VITE_AUTH_ENABLED=true
